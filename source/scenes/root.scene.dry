Q.scarman_done = 0;
Q.trident = 0;
Q.was_in_government = 0;
Q.final_election_reached = 0;
Q.last_new_year = 0;
Q.benefit_cost = 0;
Q.budget_disp = 0;
Q.interest_rate_disp = 12;
Q.inflation_2 = '9.9';
Q.unemployment_2 = '5.8';
Q.economic_growth_2 = '3.0';
Q.projected_majority_line = 318;
Q.howe_resigned = 0;
Q.invaded = 0;
Q.war_won = 0;
Q.survived = 0;
Q.survived_confidence = 0;
Q.challenge_support = 0;
Q.miners_win = 0;
Q.by_election_loss = 0;
Q.by_election_winner = "";
Q.crosby_lost = 0;
Q.hillhead_lost = 0;
Q.last_defection_time = 0;
Q.defeated_once = 0;
Q.labour_winter_seen = 0;
Q.late_victory = 0;
Q.last_cabinet_action = 0;
Q.hanging_vote = 0;

// Health: nhs_funding counts the years we funded the NHS above inflation
Q.nhs_funding = 0;
Q.prescription_charges = 0;
Q.nhs_contracting = 0;
Q.nhs_reorganised = 0;
Q.private_health = 0;
Q.nhs_griffiths = 0;
Q.cprs_leak = 0;
Q.cprs_defended = 0;
Q.health_dispute = 0;
// Education and training (school_vouchers: 1 = studied, 2 = piloted, -1 = dropped)
Q.assisted_places = 0;
Q.parental_choice = 0;
Q.university_cuts = 0;
Q.school_vouchers = 0;
Q.yts = 0;
Q.school_spending = 0;
// Social security
Q.pension_link_broken = 0;
Q.benefits_cut = 0;
Q.sick_pay_reform = 0;
Q.child_benefit = 0;
Q.fraud_drive = 0;
// The Common Market
Q.erm = 0;
Q.cap_reform = 0;
Q.lamb_war = 0;
Q.fisheries_deal = 0;
Q.single_market = 0;
// Immigration (boat_people: 1 = took them in, -1 = refused)
