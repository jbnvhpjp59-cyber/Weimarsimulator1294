// Local government
Q.rsg_cuts = 0;
Q.rate_capping = 0;
Q.rates_pledge = 0;
Q.glc_abolition = 0;
Q.docklands = 0;
Q.council_tendering = 0;

// ---------------------------------------------------------------
// Timers. Each card sets its own timer; post_event counts them down.
// ---------------------------------------------------------------
Q.timers = ['advisor_action',
            // party affairs
            'fundraising', 'speaking_tour', 'media', 'policy_group',
            'shadow_cabinet', 'target_voters', 'other_parties',
            'party_disunity', 'inner_circle',
            // commons
            'opposition_day', 'pmqs', 'devolution', 'pay_policy',
            'no_confidence', 'whips',
            // government
            'budget', 'monetary_policy', 'public_spending', 'union_law',
            'industry', 'housing', 'law_order', 'foreign_affairs',
            'defence', 'northern_ireland', 'public_pay', 'reshuffle',
            'nhs', 'education', 'social_security', 'europe', 'immigration',
            'energy', 'local_government', 'regions', 'union_leaders', 'coal_dispute',
            // events
            'by_election', 'gilt_crisis'];
for (var t of Q.timers) {
    Q[t + '_timer'] = 0;
}
// shadow cabinet members with pinned advisor cards
// the inner circle: three advisers at a time, as in the original game
Q.n_advisors = 3;
Q.whitelaw_advisor = 1;
Q.joseph_advisor = 1;
Q.howe_advisor = 1;
Q.reece_advisor = 0;
Q.prior_advisor = 0;
