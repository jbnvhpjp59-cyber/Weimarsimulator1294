title: Root Scene
new-page: true
go-to: post_event if started = 1; start_menu if started = 0

@start_menu
new-page: true
go-to: start_menu_2

= Conservatism: An Alternate History

@start_menu_2

- @start: Start game
- @election_simulation: Election simulation
- @credits: Credits
- @game_over.achievements

@start
on-arrival: {!
Q.started = 1;
// ---------------------------------------------------------------
// Time. time = 1 is January 1978; each turn is one month.
// ---------------------------------------------------------------
Q.time = 1;
Q.year = 1978;
Q.month = 1;
// how many actions have been taken this month?
Q.month_actions = 0;

// -1 = easy, 0 = normal, 1 = hard
Q.difficulty = 0;
Q.historical_mode = 0;
Q.saves_disabled = 0;
Q.discard_disabled = 0;
Q.hand_size = 3;
// party income every January (historical mode replaces fundraising with this)
Q.annual_income = 0;
Q.fundraising_disabled = 0;
// the Treasury's headroom when we take office
Q.starting_budget = 1;
// pinned cards offered on easy difficulty (or in custom settings)
Q.shuffle_leadership_enabled = 0;
Q.cabinet_enabled = 0;
Q.starting_dissent = 1;
Q.starting_relations = 1;

// ---------------------------------------------------------------
// The Conservative Party
// ---------------------------------------------------------------
// resources: money and political capital, spent on cards.
Q.resources = 3;
// donations: income from each fundraising round.
Q.donations = 2;

// overall dissent (0 to 1) is recalculated each month from the factions.
// it dampens every gain in support.
Q.dissent = 0.1;
Q.dissent_percent = 10;

// factions of the parliamentary party (strengths are normalised to 100)
// dry: free-market "Thatcherites" (Keith Joseph, Geoffrey Howe)
// wet: One Nation / Heathite moderates (Jim Prior, Ian Gilmour, Francis Pym)
// loyalist: the managers who back whoever leads (Willie Whitelaw, Lord Carrington)
// right: traditionalists, law-and-order and Unionist Tories
Q.factions = ['dry', 'wet', 'loyalist', 'right'];
Q.dry_strength = 25;
Q.dry_dissent = 5;
Q.wet_strength = 35;
Q.wet_dissent = 20;
Q.loyalist_strength = 30;
Q.loyalist_dissent = 5;
Q.right_strength = 10;
Q.right_dissent = 10;

// Edward Heath sulks on the backbenches. 0 = reconciled, 100 = open war.
Q.heath_hostility = 60;

// ---------------------------------------------------------------
// Leaders and public opinion
// ---------------------------------------------------------------
// net-ish satisfaction ratings, 0 to 100
Q.thatcher_rating = 40;
Q.lab_leader = "Callaghan";
Q.lab_leader_rating = 55;
// public appetite for free-market economics, 0 to 100
Q.economic_liberalism = 40;
// share of the public who think the unions have too much power, 0 to 100
Q.union_backlash = 55;
// how far the public trusts Labour to run the economy, 0 to 100
Q.labour_credibility = 55;

// ---------------------------------------------------------------
// The economy (the Labour government controls it, for now)
// ---------------------------------------------------------------
Q.inflation = 9.9;
Q.unemployment = 5.8;
Q.economic_growth = 3.0;
// the government's pay norm, in % (Phase 3 = 10%, Phase 4 = 5%)
Q.pay_norm = 10;
// industrial unrest, 0 to 10
Q.strike_wave = 2;

// ---------------------------------------------------------------
// Policy: planks of the next Conservative manifesto (0 = not adopted)
// ---------------------------------------------------------------
Q.policy_monetarism = 0;
Q.policy_tax_cuts = 0;
Q.policy_union_reform = 0;
Q.policy_right_to_buy = 0;
Q.policy_law_order = 0;
Q.policy_defence = 0;
Q.policy_privatisation = 0;
Q.policy_immigration = 0;
Q.manifesto_planks = 0;
// devolution: 0 = oppose the Scotland and Wales Acts,
// 1 = support them, 2 = "vote No for a better Bill"
Q.devolution_stance = 0;
// the government's incomes policy: 0 = no position, 1 = back the pay norm,
// 2 = free collective bargaining, 3 = statutory wage controls
Q.pay_stance = 0;

// ---------------------------------------------------------------
// Other parties
// ---------------------------------------------------------------
Q.lib_relation = 30;
Q.snp_relation = 25;
Q.pc_relation = 15;
Q.uup_relation = 50;
// is the Lib-Lab Pact still propping up the government?
Q.lib_lab_pact = 1;

// ---------------------------------------------------------------
// Social grades (share of the electorate)
// ab: professional & managerial, c1: white-collar,
// c2: skilled manual, de: semi/unskilled manual & state pensioners
// ---------------------------------------------------------------
Q.ab = 17;
Q.c1 = 23;
Q.c2 = 32;
Q.de = 28;
Q.classes = ['ab', 'c1', 'c2', 'de'];
// the class model covers Great Britain outside the nationalist vote.
// The SNP and Plaid Cymru are handled by the regional seat model.
Q.parties = ['con', 'lab', 'lib', 'other'];

// Support for each party by social grade. These need not sum to 100;
// they are normalised. Tuned to give roughly level pegging in Jan 1978.
Q.ab_con = 64;
Q.ab_lab = 17;
Q.ab_lib = 15;
Q.ab_other = 2;

Q.c1_con = 54;
Q.c1_lab = 30;
Q.c1_lib = 12;
Q.c1_other = 3;

Q.c2_con = 41;
Q.c2_lab = 48;
Q.c2_lib = 7;
Q.c2_other = 3;

Q.de_con = 29;
Q.de_lab = 61;
Q.de_lib = 6;
Q.de_other = 3;

// remember the starting support: post_event pulls support back towards it
Q.baseline_support = {};
for (var bc of Q.classes) {
    for (var bp of Q.parties) {
        Q.baseline_support[bc + '_' + bp] = Q[bc + '_' + bp];
    }
}

// nationalist vote within Scotland and Wales, in %
Q.snp_share = 25;
Q.pc_share = 9;

// ---------------------------------------------------------------
// The House of Commons (approximate, January 1978)
// 635 seats; 318 needed for a majority.
// "other" covers the Speaker and the breakaway Scottish Labour Party.
// ---------------------------------------------------------------
Q.total_seats = 635;
Q.majority_line = 318;
Q.con_mps = 281;
Q.lab_mps = 310;
Q.lib_mps = 13;
Q.snp_mps = 11;
Q.pc_mps = 3;
Q.ni_mps = 12;
Q.other_mps = 5;
// Unionist MPs among the Northern Irish members (15 of 17 after 1983)
Q.unionist_seats = 10;

Q.prime_minister = "Callaghan";
Q.pm_party = "Labour";
Q.con_in_government = 0;

// ---------------------------------------------------------------
// Elections. The Parliament elected in October 1974 must be
// dissolved by autumn 1979 (time 22 = October 1979).
// ---------------------------------------------------------------
Q.next_election_time = 22;
Q.election_deadline_time = 22;
Q.next_election_month = 10;
Q.next_election_year = 1979;
Q.months_to_election = 21;
Q.months_since_election = 0;
Q.months_in_office = 0;
Q.rebellion_disp = 0;
Q.cabinet_revolt_disp = 0;
Q.partner_dissent_disp = 0;
Q.in_campaign = 0;
Q.election_called = 0;
Q.n_elections = 0;
Q.apply_poll_error = 0;
Q.poll_error = 0;
// set by the no-confidence vote
Q.no_confidence_won = 0;
Q.no_confidence_lost = 0;

// records for charts
Q.party_support_records = [];
Q.election_records = [];
Q.economic_records = [];

// ---------------------------------------------------------------
// Events seen
// ---------------------------------------------------------------
Q.saatchi_hired = 0;
Q.swamped_seen = 0;
Q.autumn_election_1978 = 0;
Q.winter_of_discontent = 0;
// 0 = not yet held, 1 = Yes cleared the 40% rule, 2 = it failed
Q.devolution_referendum_result = 0;
Q.devolution_failed = 0;
Q.neave_dead = 0;
Q.tabloid_support = 0;
Q.electoral_reform_promise = 0;
// regional campaign bonuses (percentage points, Con over Lab)
Q.scotland_con_bonus = 0;
Q.midlands_con_bonus = 0;
// campaign
Q.campaign_started = 0;
Q.manifesto_launched = 0;
Q.tv_debate_decided = 0;
Q.general_election_held = 0;
// 1 = majority, 2 = Unionist deal, 3 = Liberal deal, 4 = minority, 5 = defeat
Q.result_type = 0;
// random events
Q.random_roll = 1;
Q.last_heath_outburst = 0;
Q.last_advisor_action = 0;
Q.pmq_success = 0;
Q.debate_win = 0;
Q.callaghan_calls = 0;
Q.sun_endorsed = 0;

// ---------------------------------------------------------------
// Government. Everything below matters once we win power.
// ---------------------------------------------------------------
// the game ends after this many general elections (the re-election)
Q.final_election = 3;
// how many general elections we have won, and whether we are in a second term
Q.terms_won = 0;
Q.second_term = 0;
Q.second_term_start = 0;
Q.whitelaw_lords = 0;
Q.pym_sacked = 0;
Q.last_election_time = 0;
Q.term_start_time = 0;
// 1 = majority, 2 = Unionist deal, 3 = Liberal deal, 4 = minority
Q.govt_type = 0;
Q.con_majority = 0;
Q.ousted = 0;
Q.government_fell = 0;

// The Treasury. budget is the government's fiscal headroom: negative
// means borrowing. Below -5, the markets revolt.
Q.budget = 0;
Q.basic_rate = 33;
Q.top_rate = 83;
Q.vat = 8;
// public spending relative to Labour's plans (negative = cuts)
Q.spending = 0;
// Minimum Lending Rate (Bank Rate), in %
Q.interest_rate = 12;
// exchange-rate index: high sterling hurts manufacturing
Q.sterling = 50;
Q.mtfs = 0;
Q.exchange_controls = 1;
Q.north_sea_oil = 0;
// "The lady's not for turning": 1 = held course, -1 = U-turn
Q.u_turn = 0;

// Industry and unions
// union power, 0-100: falls with union law, rises with defeats
Q.union_power = 70;
Q.employment_acts = 0;
Q.privatisations = 0;
Q.right_to_buy_progress = 0;
Q.industry_subsidy = 0;
// coal stocks at power stations, 0-3: a miners' strike can't be won without them
Q.coal_stocks = 0;
Q.miners_beaten = 0;

// The Cabinet. Treasury, Employment and Industry each go to a dry or a wet.
// cabinet_dry (0-100) is how far the Cabinet backs the radical programme.
Q.chancellor = "Howe";
Q.chancellor_dry = 1;
Q.employment_secretary = "Prior";
Q.employment_dry = 0;
Q.industry_secretary = "Joseph";
Q.industry_dry = 1;
Q.foreign_secretary = "Carrington";
Q.foreign_dry = 0;
// the rest of the Cabinet (dry = 1 backs the radical programme)
Q.home_secretary = "Whitelaw";
Q.home_dry = 0;
Q.environment_secretary = "Heseltine";
Q.environment_dry = 0;
Q.defence_secretary = "Pym";
Q.defence_dry = 0;
Q.education_secretary = "Carlisle";
Q.education_dry = 0;
Q.health_secretary = "Jenkin";
Q.health_dry = 1;
Q.cabinet_dries = 3;
// reshuffles and resignations
Q.purge_count = 0;
Q.tebbit_elsewhere = 0;
Q.january_reshuffle_seen = 0;
Q.last_resignation = 0;
Q.resignations = 0;
Q.dry_walkout_seen = 0;
Q.scandal_seen = 0;
Q.scandal_worse = 0;
// historical events, 1979-83
Q.mountbatten_seen = 0;
Q.olympics_seen = 0;
Q.olympic_boycott = 0;
Q.lords_seen = 0;
Q.civil_service_seen = 0;
Q.warrington_seen = 0;
Q.royal_wedding_seen = 0;
Q.benn_seen = 0;
Q.benn_won = 0;
Q.scargill_seen = 0;
Q.scargill = 0;
Q.aslef_seen = 0;
Q.pipeline_seen = 0;
Q.pipeline_defied = 0;
Q.hong_kong_seen = 0;
Q.hong_kong_firm = 0;
Q.greenham_seen = 0;
Q.cruise_deployed = 0;
Q.bermondsey_seen = 0;
Q.resign_post = "";
Q.resign_name = "";
Q.resign_var = "";
Q.cabinet_dry = 40;
Q.wets_purged = 0;
// pressure from the wets inside Cabinet, 0-10: at 10 they revolt
Q.cabinet_revolt = 0;
// backbench rebellion, 0-10: high values defeat bills and threaten the leader
Q.rebellion = 0;
// discontent of our partners if we govern without a majority, 0-10
Q.partner_dissent = 0;
Q.leadership_challenge_time = 0;

// Opposition
Q.lab_left = 0;
Q.alliance_formed = 0;
Q.lib_name = "Liberal";
Q.sdp_defections = 0;
Q.falklands_factor = 0;

// Foreign affairs and defence
Q.europe_relation = 50;
Q.us_relation = 55;
Q.eec_rebate = 0;
Q.defence_cuts = 0;
Q.endurance_withdrawn = 0;
// 0 = nothing, 1 = invaded, 2 = task force sailing, 3 = won, 4 = lost, 5 = negotiated away, 6 = deterred
Q.falklands = 0;
Q.falklands_odds = 0;

// One-off events in government
Q.howe_budget_done = 0;
Q.unemployment_2m = 0;
Q.unemployment_3m = 0;
Q.riots = 0;
Q.hunger_strike_conceded = 0;
Q.new_boundaries = 0;
Q.police_pay_done = 0;
