title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// keep support numbers non-negative
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c + '_' + party] < 0) {
            Q[c + '_' + party] = 0;
        }
    }
}

// clamp 0-100 opinion meters
var meters = ['thatcher_rating', 'lab_leader_rating', 'economic_liberalism', 'union_power',
              'union_backlash', 'labour_credibility', 'heath_hostility',
              'lib_relation', 'snp_relation', 'pc_relation', 'uup_relation'];
for (var m of meters) {
    if (Q[m] < 0) {
        Q[m] = 0;
    } else if (Q[m] > 100) {
        Q[m] = 100;
    }
}
if (Q.strike_wave < 0) {
    Q.strike_wave = 0;
} else if (Q.strike_wave > 10) {
    Q.strike_wave = 10;
}

// ---- factions and dissent ----
var total_strength = 0;
for (var f of Q.factions) {
    if (Q[f + '_dissent'] < 0) {
        Q[f + '_dissent'] = 0;
    } else if (Q[f + '_dissent'] >= 100) {
        Q[f + '_dissent'] = 99;
    }
    if (Q[f + '_strength'] < 1) {
        Q[f + '_strength'] = 1;
    }
    total_strength += Q[f + '_strength'];
}
var total_dissent = 0;
for (var f of Q.factions) {
    Q[f + '_strength'] = 100 * Q[f + '_strength'] / total_strength;
    total_dissent += Q[f + '_strength'] * Q[f + '_dissent'];
}
Q.dissent = 0.01 * total_dissent / 100;
if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}
Q.dissent_percent = Q.dissent * 100;

// count manifesto planks
Q.manifesto_planks = Q.policy_monetarism + Q.policy_tax_cuts + Q.policy_union_reform +
    Q.policy_right_to_buy + Q.policy_law_order + Q.policy_defence +
    Q.policy_privatisation + Q.policy_immigration;

// ---- advance the month ----
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        if (Q.annual_income > 0) {
            Q.resources += Q.annual_income;
        }
    }
    for (var timer of Q.timers) {
        if (Q[timer + '_timer'] && Q[timer + '_timer'] > 0) {
            Q[timer + '_timer'] -= 1;
        }
    }
    // a fresh roll each month for random events
    Q.random_roll = Math.random();
    Q.party_support_records.push({'date': new Date(Q.year, Q.month - 1),
                                  'con': Q.con_votes, 'lab': Q.lab_votes,
                                  'lib': Q.lib_votes});
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Math.round(Q.inflation * 10) / 10,
                             'unemployment': Math.round(Q.unemployment * 10) / 10});

    // ---- the economy and the national mood: opposition years ----
    // Spring and summer 1978: inflation falls into single figures and
    // Labour recovers. From autumn 1978, the 5% pay norm meets the unions.
    var in_winter_crisis = (Q.year == 1978 && Q.month >= 10) || (Q.year == 1979 && Q.month <= 3);
    if (!Q.con_in_government && Q.n_elections == 0) {
        if (Q.year == 1978 && Q.month <= 8) {
            Q.inflation -= 0.25;
            Q.unemployment -= 0.03;
            Q.lab_leader_rating += 0.5;
            Q.labour_credibility += 0.6;
            Q.c2_lab += 0.25;
            Q.de_lab += 0.2;
            Q.snp_share -= 0.3;
        } else {
            Q.inflation += 0.15;
            Q.snp_share -= 0.15;
        }
        if (Q.pay_norm <= 5 && in_winter_crisis) {
            Q.strike_wave += 0.6;
        }
        if (Q.inflation >= 10) {
            Q.labour_credibility -= 1;
        }
    }
    if (Q.strike_wave >= 3) {
        Q.union_backlash += 0.4 * Q.strike_wave;
        if (!Q.con_in_government) {
            Q.labour_credibility -= 0.3 * Q.strike_wave;
            Q.lab_leader_rating -= 0.2 * Q.strike_wave;
        }
    } else {
        // once the strikes end, tempers cool and Labour slowly recovers
        if (Q.union_backlash > 55) {
            Q.union_backlash -= 1.5;
        }
        if (Q.labour_credibility < 50) {
            Q.labour_credibility += 0.5;
        }
    }
    // outside the winter pay round, disputes settle quickly
    if (!in_winter_crisis && Q.strike_wave > 2) {
        Q.strike_wave -= 1.5;
    }

    // ---- the economy after the first election, whoever governs ----
    // (in opposition, Labour runs it: rates stay put and an incomes policy
    // brings strikes back every winter)
    if (Q.con_in_government || Q.n_elections >= 1) {
        var u_start = Q.unemployment;
        if (Q.con_in_government) {
            Q.months_in_office = Q.time - Q.term_start_time;
        } else if ((Q.month >= 11 || Q.month <= 2) && Q.pay_norm <= 5) {
            Q.strike_wave += 0.4;
        }
        // external shocks: the second oil shock (mid-1979 to mid-1980),
        // world recession (1980-81), world recovery (from 1982)
        if (Q.time >= 17 && Q.time <= 30) {
            Q.inflation += 0.3;
        }
        if ((Q.year == 1980 || Q.year == 1981) && Q.economic_growth > -2.5) {
            Q.economic_growth -= 0.15;
        }
        if (Q.year >= 1982 && Q.economic_growth < 3) {
            Q.economic_growth += 0.15;
        }
        // growth drifts back towards its long-run trend
        Q.economic_growth += (1.5 - Q.economic_growth) * 0.04;
        // monetary policy: dear money beats inflation, at the cost of jobs
        // and an overvalued pound
        if (Q.interest_rate >= 15) {
            Q.inflation -= 0.3;
            Q.unemployment += 0.08;
            Q.economic_growth -= 0.08;
            Q.sterling += 1.5;
        } else if (Q.interest_rate >= 12) {
            Q.inflation -= 0.15;
            Q.unemployment += 0.04;
            Q.sterling += 0.5;
        } else if (Q.interest_rate <= 9) {
            Q.inflation += 0.15;
            Q.unemployment -= 0.04;
            Q.economic_growth += 0.05;
            Q.sterling -= 1;
        }
        if (Q.mtfs) {
            Q.inflation -= 0.05;
        }
        // North Sea oil props up the pound
        if (Q.year >= 1980) {
            Q.sterling += 0.3;
        }
        Q.sterling += (50 - Q.sterling) * 0.03;
        // an overvalued pound crushes manufacturing
        if (Q.sterling >= 65) {
            Q.unemployment += 0.06;
            Q.economic_growth -= 0.05;
        }
        // fiscal policy
        if (Q.budget < 0) {
            Q.inflation += 0.06 * -Q.budget;
        }
        if (Q.spending < 0) {
            Q.unemployment += 0.02 * -Q.spending;
        } else if (Q.spending > 0) {
            Q.unemployment -= 0.02 * Q.spending;
            Q.inflation += 0.03 * Q.spending;
        }
        // unemployment follows growth, with a lag (Okun's law); rises slow
        // once it is very high, as discouraged workers drop out of the count
        var du = (1.5 - Q.economic_growth) * 0.05;
        if (du > 0 && Q.unemployment > 12) {
            du *= 0.1;
        } else if (du > 0 && Q.unemployment > 10) {
            du *= 0.35;
        }
        Q.unemployment += du;
        // mass unemployment pushes inflation down (the Phillips curve)
        if (Q.unemployment > 8) {
            Q.inflation -= 0.05 * (Q.unemployment - 8);
        }
        if (Q.inflation < 1.5) {
            Q.inflation = 1.5;
        }
        // past 12%, each month's rise in the count slows sharply: the
        // discouraged stop registering, and some leave the labour market
        if (Q.unemployment > u_start && Q.unemployment > 12) {
            Q.unemployment = u_start + (Q.unemployment - u_start) * (Q.unemployment > 14 ? 0.2 : 0.4);
        }
        // from 1982, as inflation falls the markets and the Bank bring rates
        // down whether or not the Chancellor says so
        if (Q.year >= 1982 && Q.inflation < 6 && Q.interest_rate > Q.inflation + 6) {
            Q.interest_rate -= 0.25;
        }
        if (Q.unemployment < 3) {
            Q.unemployment = 3;
        }
        if (Q.economic_growth < -5) {
            Q.economic_growth = -5;
        } else if (Q.economic_growth > 6) {
            Q.economic_growth = 6;
        }

        // ---- the government is judged on the economy ----
        // gp is the governing party, op the main opposition
        var gp = Q.con_in_government ? 'con' : 'lab';
        var op = Q.con_in_government ? 'lab' : 'con';
        if (Q.unemployment > 6) {
            var u = Q.unemployment - 6;
            Q['c2_' + gp] -= 0.06 * u;
            Q['de_' + gp] -= 0.06 * u;
            Q['c1_' + gp] -= 0.03 * u;
            Q['c2_' + op] += 0.03 * u;
            Q['de_' + op] += 0.04 * u;
        }
        if (Q.inflation > 10) {
            var inf = Q.inflation - 10;
            for (var c of Q.classes) {
                Q[c + '_' + gp] -= 0.03 * inf;
            }
        } else if (Q.inflation < 7 && (Q.months_in_office > 12 || !Q.con_in_government)) {
            Q['c1_' + gp] += 0.15;
            Q['ab_' + gp] += 0.1;
            Q['c2_' + gp] += 0.1;
        }
        if (Q.economic_growth > 2) {
            Q['c1_' + gp] += 0.15;
            Q['c2_' + gp] += 0.15;
        }
        if (!Q.con_in_government) {
            Q.lab_leader_rating += (7 - Q.unemployment) * 0.05 + (8 - Q.inflation) * 0.03;
            if (Q.lab_leader_rating > 50) {
                Q.lab_leader_rating -= 0.3;
            } else if (Q.lab_leader_rating < 30) {
                Q.lab_leader_rating += 0.3;
            }
        }
    }
    if (Q.con_in_government) {
        // mortgage holders feel dear money
        if (Q.interest_rate >= 15) {
            Q.c1_con -= 0.15;
            Q.c2_con -= 0.1;
        }
        // council tenants who bought their homes
        if (Q.right_to_buy_progress > 0) {
            Q.c2_con += 0.05 * Q.right_to_buy_progress;
            Q.de_con += 0.05 * Q.right_to_buy_progress;
        }
        // the Falklands factor
        if (Q.falklands_factor > 0) {
            for (var c of Q.classes) {
                Q[c + '_con'] += 0.25;
            }
            Q.falklands_factor -= 1;
        }
        Q.thatcher_rating += (7 - Q.unemployment) * 0.05 + (8 - Q.inflation) * 0.03;

        // ---- threat meters ----
        // backbench rebellion grows when factions are angry, and fades slowly
        for (var f of Q.factions) {
            if (Q[f + '_dissent'] > 45) {
                Q.rebellion += 0.3;
            }
        }
        if (Q.thatcher_rating < 25) {
            Q.rebellion += 0.15;
        }
        Q.rebellion -= 0.25;
        // wets inside the Cabinet resist spending cuts
        if (Q.spending < 0 && Q.cabinet_dry < 60) {
            Q.cabinet_revolt += 0.15 * -Q.spending;
        }
        Q.cabinet_revolt -= 0.15;
        // partners in a hung parliament grow restless
        if (Q.govt_type >= 2) {
            Q.partner_dissent += 0.15;
        }
        var meters10 = ['rebellion', 'cabinet_revolt', 'partner_dissent'];
        for (var m10 of meters10) {
            if (Q[m10] < 0) {
                Q[m10] = 0;
            } else if (Q[m10] > 10) {
                Q[m10] = 10;
            }
        }
    }

    // ---- support drifts back towards its January 1978 level ----
    // Gains have to be sustained, not banked: each month 8% of the gap
    // closes, so a one-off boost has a half-life of about eight months.
    if (Q.baseline_support) {
        for (var c of Q.classes) {
            for (var party of Q.parties) {
                var key = c + '_' + party;
                if (Q.baseline_support[key] !== undefined) {
                    Q[key] += (Q.baseline_support[key] - Q[key]) * 0.08;
                }
            }
        }
    }

    // ---- opinion feeds into party support ----
    if (Q.union_backlash >= 60) {
        var ub = (Q.union_backlash - 60) / 20;
        Q.c2_con += 0.35 * ub * (1 - Q.dissent);
        Q.c1_con += 0.25 * ub * (1 - Q.dissent);
        Q.de_con += 0.2 * ub * (1 - Q.dissent);
        if (Q.policy_union_reform) {
            Q.c2_con += 0.3 * ub * (1 - Q.dissent);
            Q.c2_lab -= 0.2 * ub;
        }
    }
    if (Q.labour_credibility < 40) {
        Q.c2_lab -= 0.3;
        Q.c1_lab -= 0.2;
        Q.de_lab -= 0.2;
    } else if (Q.labour_credibility > 60) {
        Q.c2_lab += 0.3;
        Q.c1_lab += 0.2;
    }
    var leader_gap = Q.thatcher_rating - Q.lab_leader_rating;
    if (leader_gap <= -20) {
        Q.c1_con -= 0.3;
        Q.c1_lib += 0.2;
        Q.c2_con -= 0.2;
    } else if (leader_gap <= -10) {
        Q.c1_con -= 0.15;
    } else if (leader_gap >= 0) {
        Q.c1_con += 0.3;
        Q.c2_con += 0.2;
    }
    // a divided party bleeds support
    if (Q.dissent > 0.3) {
        for (var c of Q.classes) {
            Q[c + '_con'] -= 0.6;
        }
    } else if (Q.dissent > 0.2) {
        for (var c of Q.classes) {
            Q[c + '_con'] -= 0.3;
        }
    }
    // Labour fights back: the bigger our lead, the harder their machine
    // (and the unions' money) works to win back its voters.
    var lead = Q.con_votes - Q.lab_votes;
    if (lead > 2) {
        var machine = (Q.lab_left ? 0.5 : 1) * (Q.alliance_formed ? 0.7 : 1);
        Q.c2_lab += 0.12 * (lead - 2) * machine;
        Q.de_lab += 0.1 * (lead - 2) * machine;
        Q.c1_lab += 0.06 * (lead - 2) * machine;
    }
    // a Heath intervention now and then
    if (Q.heath_hostility >= 70) {
        Q.wet_dissent += 1;
        Q.thatcher_rating -= 0.5;
    }
    // ratings drift back towards their baselines
    if (Q.thatcher_rating > 45) {
        Q.thatcher_rating -= 0.3;
    } else if (Q.thatcher_rating < 35) {
        Q.thatcher_rating += 0.3;
    }
    if (Q.snp_share < 12) {
        Q.snp_share = 12;
    }
    if (Q.unemployment < 1) {
        Q.unemployment = 1;
    }
}

// unemployment region by region, which the seat model uses
this._runActions(this.game.scenes['regional_economy'].onArrival);
// the union leaders' moods, and Labour fighting itself
this._runActions(this.game.scenes['union_leaders'].onArrival);
this._runActions(this.game.scenes['labour_civil_war'].onArrival);
// the miners' strike, if it has begun
this._runActions(this.game.scenes['miners_tick'].onArrival);

// recalculate projected votes and seats
this._runActions(this.game.scenes['election_algorithm'].onArrival);

// how many months until the election, and since the last one?
Q.months_to_election = Q.next_election_time - Q.time;
Q.months_since_election = Q.time - Q.last_election_time;
Q.rebellion_disp = Math.round(Q.rebellion);
Q.cabinet_revolt_disp = Math.round(Q.cabinet_revolt);
Q.partner_dissent_disp = Math.round(Q.partner_dissent);
Q.budget_disp = Math.round(Q.budget * 10) / 10;
Q.interest_rate_disp = Math.round(Q.interest_rate * 10) / 10;
Q.inflation_2 = Q.inflation.toFixed(1);
Q.unemployment_2 = Q.unemployment.toFixed(1);
Q.economic_growth_2 = Q.economic_growth.toFixed(1);
Q.economic_liberalism_disp = Math.round(Q.economic_liberalism);
Q.union_backlash_disp = Math.round(Q.union_backlash);
Q.labour_credibility_disp = Math.round(Q.labour_credibility);
Q.next_election_month = ((Q.next_election_time - 1) % 12) + 1;
Q.next_election_year = 1978 + Math.floor((Q.next_election_time - 1) / 12);
// the last two months before polling day are the campaign
Q.in_campaign = (Q.months_to_election <= 2) ? 1 : 0;

// the Cabinet's balance follows whoever holds each department
this._runActions(this.game.scenes['cabinet_recalc'].onArrival);

// bills move through Parliament
this._runActions(this.game.scenes['bill_tick'].onArrival);

// once a month, the front page reports the month just gone
this._runActions(this.game.scenes['newsroom'].onArrival);

// "Broad Church": a wet, a dry and a loyalist in the inner circle at once
var circle_wets = Q.prior_advisor + Q.pym_advisor + Q.heseltine_advisor + Q.gilmour_advisor + Q.stevas_advisor;
var circle_dries = Q.joseph_advisor + Q.howe_advisor + Q.lawson_advisor + Q.biffen_advisor + Q.brittan_advisor + Q.nott_advisor;
var circle_loyalists = Q.whitelaw_advisor + Q.carrington_advisor + Q.parkinson_advisor;
if (circle_wets > 0 && circle_dries > 0 && circle_loyalists > 0 && !Q.game_achievement_broad_church) {
    this.achieve('broad_church');
}

Q.has_event = 0;
// check if there are any events this month; if not, go to the main hand.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and hand_size == 3; main.main_easy if has_event = 0 and hand_size == 4

= [+ month : month +] [+ year +]

@events_choice

- #event

# This scene updates numbers after each action, then routes to events or the main hand.
