title: Next month
set-bg: img/map.jpg
is-hand: true
on-arrival: {!
var label = Q.con_in_government ? 'Cabinet' : 'Shadow Cabinet';
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = label + ' - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = label + ' - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = label + ' - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 3

# The main deck is displayed here. Clicking a deck draws a card into your hand; clicking a card plays it.

[? if in_campaign : **The general election campaign is under way.** Polling day is [+ next_election_month : month +] [+ next_election_year +]. ?]

- @party
- @govt
- @commons
- @campaign
- #advisor
- @inner_circle_pinned

