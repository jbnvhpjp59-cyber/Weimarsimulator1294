title: Next month
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Shadow Cabinet - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Shadow Cabinet - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Shadow Cabinet - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 3

# The main deck is displayed here. Clicking a deck draws a card into your hand; clicking a card plays it.

